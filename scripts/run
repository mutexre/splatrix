#!/usr/bin/env python3
"""run — Splatrix worktree dispatcher.

Resolves a SPLAT-N ticket to its git worktree path and dispatches `make`
targets there. Single-file, no shell sourcing, no per-shell completion.

Setup:
    ln -s <splatrix-repo>/scripts/run /usr/local/bin/run

Discovery of the splatrix main repo (in priority order):
    1. $SPLATRIX_REPO env var (absolute path to main worktree)
    2. ~/.config/splatrix/run.conf  (single line: SPLATRIX_REPO=<path>)
    3. Auto-detect: walk up from this script's location, find git common dir.

Run state lives in ~/.cache/run/<ticket>.{pid,log}.
"""

from __future__ import annotations

import argparse
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Optional


CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "run"
CONFIG_FILE = (
    Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    / "splatrix"
    / "run.conf"
)
TICKET_RE = re.compile(r"SPLAT-\d+", re.IGNORECASE)


# ─────────────────────────────────────────────────────────────────────────────
# Output helpers
# ─────────────────────────────────────────────────────────────────────────────

def info(msg: str) -> None:
    print(f"[run] {msg}", file=sys.stderr)


def err(msg: str) -> int:
    print(f"[run] error: {msg}", file=sys.stderr)
    return 1


# ─────────────────────────────────────────────────────────────────────────────
# Repo + worktree discovery
# ─────────────────────────────────────────────────────────────────────────────

def _read_config_repo() -> Optional[Path]:
    if not CONFIG_FILE.exists():
        return None
    for line in CONFIG_FILE.read_text().splitlines():
        line = line.strip()
        if line.startswith("SPLATRIX_REPO="):
            p = Path(line.split("=", 1)[1].strip()).expanduser()
            return p if p.is_dir() else None
    return None


def _autodetect_repo() -> Optional[Path]:
    # The script is shipped as <repo>/scripts/run, so the main repo is its
    # parent's parent. Resolve symlinks to find the real script location.
    real = Path(__file__).resolve()
    candidate = real.parent.parent
    if (candidate / ".git").exists() and (candidate / "splatrix").is_dir():
        return candidate
    return None


def _resolve_main_repo() -> Path:
    env = os.environ.get("SPLATRIX_REPO")
    if env:
        p = Path(env).expanduser()
        if p.is_dir():
            return p
    cfg = _read_config_repo()
    if cfg:
        return cfg
    auto = _autodetect_repo()
    if auto:
        return auto
    sys.exit(
        err(
            "cannot locate splatrix main repo. Set $SPLATRIX_REPO, write "
            f"SPLATRIX_REPO=<path> into {CONFIG_FILE}, or symlink this script "
            "from <repo>/scripts/run."
        )
    )


@dataclass
class Worktree:
    path: Path
    branch: str  # may be "(detached)" if no branch
    ticket: Optional[str]  # uppercase SPLAT-N, or None

    @property
    def label(self) -> str:
        return self.ticket or f"({self.path.name})"


def _list_worktrees(main_repo: Path) -> list[Worktree]:
    out = subprocess.run(
        ["git", "-C", str(main_repo), "worktree", "list", "--porcelain"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout

    worktrees: list[Worktree] = []
    cur_path: Optional[Path] = None
    cur_branch = "(detached)"
    for line in out.splitlines():
        if line.startswith("worktree "):
            if cur_path is not None:
                worktrees.append(_make_worktree(cur_path, cur_branch))
            cur_path = Path(line[len("worktree "):])
            cur_branch = "(detached)"
        elif line.startswith("branch "):
            cur_branch = line[len("branch "):].removeprefix("refs/heads/")
        elif line.startswith("detached"):
            cur_branch = "(detached)"
    if cur_path is not None:
        worktrees.append(_make_worktree(cur_path, cur_branch))
    return worktrees


def _make_worktree(path: Path, branch: str) -> Worktree:
    m = TICKET_RE.search(branch)
    ticket = m.group(0).upper() if m else None
    return Worktree(path=path, branch=branch, ticket=ticket)


def _resolve_ticket(arg: str, worktrees: list[Worktree]) -> Worktree:
    arg_l = arg.lower()
    arg_u = arg.upper()
    if not arg_u.startswith("SPLAT-") and arg.isdigit():
        arg_u = f"SPLAT-{arg}"
    exact = [w for w in worktrees if w.ticket == arg_u]
    if len(exact) == 1:
        return exact[0]
    if len(exact) > 1:
        sys.exit(err(f"multiple worktrees match {arg_u}: {[str(w.path) for w in exact]}"))
    fuzzy = [
        w for w in worktrees
        if (w.ticket and arg_l in w.ticket.lower())
        or arg_l in w.branch.lower()
        or arg_l in w.path.name.lower()
    ]
    if len(fuzzy) == 1:
        return fuzzy[0]
    if not fuzzy:
        sys.exit(err(f"no worktree matches '{arg}'. Try `run ls`."))
    sys.exit(
        err(
            f"ambiguous '{arg}' matches: "
            + ", ".join(w.label for w in fuzzy)
            + ". Be more specific."
        )
    )


# ─────────────────────────────────────────────────────────────────────────────
# PID file helpers (detached lifecycle)
# ─────────────────────────────────────────────────────────────────────────────

def _slug(ticket_or_label: str) -> str:
    return re.sub(r"[^A-Za-z0-9._-]", "_", ticket_or_label)


def _pid_file(label: str) -> Path:
    return CACHE_DIR / f"{_slug(label)}.pid"


def _log_file(label: str) -> Path:
    return CACHE_DIR / f"{_slug(label)}.log"


def _read_pid(pid_file: Path) -> Optional[int]:
    if not pid_file.exists():
        return None
    try:
        return int(pid_file.read_text().strip())
    except (ValueError, OSError):
        return None


def _is_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def _terminate(pid: int, timeout: float = 5.0) -> bool:
    """SIGTERM, wait up to timeout, fallback SIGKILL. Return True on success."""
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return True
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if not _is_alive(pid):
            return True
        time.sleep(0.1)
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        return True
    time.sleep(0.2)
    return not _is_alive(pid)


# ─────────────────────────────────────────────────────────────────────────────
# Commands
# ─────────────────────────────────────────────────────────────────────────────

def cmd_ls(_args, worktrees: list[Worktree]) -> int:
    rows = [("TICKET", "BRANCH", "WORKTREE")]
    for w in sorted(worktrees, key=lambda w: (w.ticket or "~", w.branch)):
        rows.append((w.ticket or "—", w.branch, str(w.path)))
    widths = [max(len(r[i]) for r in rows) for i in range(3)]
    for r in rows:
        print(f"{r[0]:<{widths[0]}}  {r[1]:<{widths[1]}}  {r[2]}")
    return 0


def cmd_path(args, worktrees: list[Worktree]) -> int:
    w = _resolve_ticket(args.ticket, worktrees)
    print(str(w.path))
    return 0


def cmd_open(args, worktrees: list[Worktree]) -> int:
    w = _resolve_ticket(args.ticket, worktrees)
    if shutil.which("cursor"):
        return subprocess.call(["cursor", str(w.path)])
    if sys.platform == "darwin":
        return subprocess.call(["open", "-a", "Cursor", str(w.path)])
    return err(f"don't know how to open Cursor on {sys.platform}; install the `cursor` CLI")


def cmd_logs(args, worktrees: list[Worktree]) -> int:
    w = _resolve_ticket(args.ticket, worktrees)
    log = _log_file(w.label)
    if not log.exists():
        return err(f"no log for {w.label} ({log})")
    return subprocess.call(["tail", "-F", str(log)])


def cmd_launch_fg(args, worktrees: list[Worktree]) -> int:
    w = _resolve_ticket(args.ticket, worktrees)
    info(f"worktree: {w.path}")
    info(f"branch:   {w.branch}")
    info(f"running:  make run")
    return subprocess.call(["make", "run"], cwd=str(w.path))


def cmd_launch_detached(args, worktrees: list[Worktree]) -> int:
    w = _resolve_ticket(args.ticket, worktrees)
    pid_file = _pid_file(w.label)
    log_file = _log_file(w.label)

    existing = _read_pid(pid_file)
    if existing and _is_alive(existing):
        if not args.force:
            return err(
                f"{w.label} already running (pid {existing}). "
                f"Use `run stop {w.label}` or pass --force to replace."
            )
        info(f"--force: stopping existing pid {existing}")
        _terminate(existing)
        try:
            pid_file.unlink()
        except FileNotFoundError:
            pass

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    log_fp = open(log_file, "ab")
    proc = subprocess.Popen(
        ["make", "run"],
        cwd=str(w.path),
        stdin=subprocess.DEVNULL,
        stdout=log_fp,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    pid_file.write_text(f"{proc.pid}\n")
    info(f"started {w.label} (pid {proc.pid}), log: {log_file}")
    return 0


def cmd_stop(args, worktrees: list[Worktree]) -> int:
    if args.all:
        if not CACHE_DIR.exists():
            info("nothing running")
            return 0
        any_stopped = False
        for pid_file in sorted(CACHE_DIR.glob("*.pid")):
            label = pid_file.stem
            pid = _read_pid(pid_file)
            if pid and _is_alive(pid):
                info(f"stopping {label} (pid {pid})")
                _terminate(pid)
                any_stopped = True
            try:
                pid_file.unlink()
            except FileNotFoundError:
                pass
        if not any_stopped:
            info("nothing running")
        return 0

    if not args.ticket:
        return err("specify <ticket> or --all")

    w = _resolve_ticket(args.ticket, worktrees)
    pid_file = _pid_file(w.label)
    pid = _read_pid(pid_file)
    if not pid:
        info(f"{w.label} is not running (no PID file)")
        return 0
    if not _is_alive(pid):
        info(f"{w.label} pid {pid} is stale, cleaning PID file")
        pid_file.unlink(missing_ok=True)
        return 0
    info(f"stopping {w.label} (pid {pid})")
    ok = _terminate(pid)
    pid_file.unlink(missing_ok=True)
    return 0 if ok else err(f"failed to stop pid {pid}")


def cmd_status(_args, _worktrees: list[Worktree]) -> int:
    if not CACHE_DIR.exists():
        print("no detached apps running")
        return 0
    rows = [("TICKET", "PID", "UPTIME", "LOG")]
    found = False
    for pid_file in sorted(CACHE_DIR.glob("*.pid")):
        label = pid_file.stem
        pid = _read_pid(pid_file)
        if not pid or not _is_alive(pid):
            pid_file.unlink(missing_ok=True)
            continue
        try:
            mtime = pid_file.stat().st_mtime
            uptime = _format_uptime(time.time() - mtime)
        except OSError:
            uptime = "?"
        rows.append((label, str(pid), uptime, str(_log_file(label))))
        found = True
    if not found:
        print("no detached apps running")
        return 0
    widths = [max(len(r[i]) for r in rows) for i in range(4)]
    for r in rows:
        print(
            f"{r[0]:<{widths[0]}}  {r[1]:>{widths[1]}}  "
            f"{r[2]:<{widths[2]}}  {r[3]}"
        )
    return 0


def _format_uptime(seconds: float) -> str:
    s = int(seconds)
    h, rem = divmod(s, 3600)
    m, s = divmod(rem, 60)
    return f"{h:02d}:{m:02d}:{s:02d}"


# ─────────────────────────────────────────────────────────────────────────────
# Entry point
# ─────────────────────────────────────────────────────────────────────────────

def _build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="run",
        description="Splatrix worktree dispatcher.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            "  run ls                  list all worktrees\n"
            "  run SPLAT-12            launch app for SPLAT-12 (foreground)\n"
            "  run 12                  same, fuzzy match\n"
            "  run -d SPLAT-12         launch detached\n"
            "  run -d SPLAT-12 --force replace running detached\n"
            "  run stop SPLAT-12       stop detached\n"
            "  run stop --all          stop all detached\n"
            "  run status              show running detached apps\n"
            "  run logs SPLAT-12       tail detached log\n"
            "  run path SPLAT-12       print worktree path (use: cd $(run path SPLAT-12))\n"
            "  run open SPLAT-12       open worktree in new Cursor window\n"
        ),
    )
    sub = p.add_subparsers(dest="cmd")

    sp_ls = sub.add_parser("ls", help="list all worktrees", aliases=["list"])
    sp_ls.set_defaults(func=cmd_ls)

    sp_path = sub.add_parser("path", help="print worktree path")
    sp_path.add_argument("ticket")
    sp_path.set_defaults(func=cmd_path)

    sp_open = sub.add_parser("open", help="open worktree in new Cursor window")
    sp_open.add_argument("ticket")
    sp_open.set_defaults(func=cmd_open)

    sp_logs = sub.add_parser("logs", help="tail detached log")
    sp_logs.add_argument("ticket")
    sp_logs.set_defaults(func=cmd_logs)

    sp_stop = sub.add_parser("stop", help="stop detached app")
    sp_stop.add_argument("ticket", nargs="?")
    sp_stop.add_argument("--all", action="store_true", help="stop every detached app")
    sp_stop.set_defaults(func=cmd_stop)

    sp_status = sub.add_parser("status", help="show running detached apps")
    sp_status.set_defaults(func=cmd_status)

    sub.add_parser("help", help="show this help message").set_defaults(
        func=lambda a, w: (p.print_help() or 0)
    )

    return p


def main(argv: list[str]) -> int:
    # Default subcommand: `run` → `run ls`. Bare `<ticket>` → launch fg.
    # `-d <ticket>` → detached launch.
    if len(argv) == 0:
        argv = ["ls"]

    # Detached form: first positional `-d` (with optional --force) followed by ticket.
    if argv[0] == "-d":
        d_parser = argparse.ArgumentParser(prog="run -d", add_help=False)
        d_parser.add_argument("ticket")
        d_parser.add_argument("--force", action="store_true")
        d_args = d_parser.parse_args(argv[1:])
        main_repo = _resolve_main_repo()
        worktrees = _list_worktrees(main_repo)
        return cmd_launch_detached(d_args, worktrees)

    # If first arg looks like a ticket (or fuzzy match), treat as foreground launch.
    first = argv[0]
    if first not in {
        "ls", "list", "path", "open", "logs", "stop", "status", "help",
        "-h", "--help",
    }:
        f_parser = argparse.ArgumentParser(prog="run", add_help=False)
        f_parser.add_argument("ticket")
        f_args = f_parser.parse_args(argv)
        main_repo = _resolve_main_repo()
        worktrees = _list_worktrees(main_repo)
        return cmd_launch_fg(f_args, worktrees)

    parser = _build_parser()
    args = parser.parse_args(argv)
    if not args.cmd:
        parser.print_help()
        return 0
    main_repo = _resolve_main_repo()
    worktrees = _list_worktrees(main_repo)
    return args.func(args, worktrees)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
